APP_NAME="Learn by Bluxor"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
LANDING_PAGE_PUBLIC_ORIGIN=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=learn_bluxor
DB_USERNAME=learn_bluxor
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CORS_ALLOWED_ORIGINS="${FRONTEND_URL}"

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
PRIVATE_FILESYSTEM_DISK=s3
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_ENDPOINT=

PIPRAPAY_ENABLED=true
PIPRAPAY_BASE_URL=https://sandbox.piprapay.com
PIPRAPAY_API_KEY=
PIPRAPAY_CURRENCY=BDT
PIPRAPAY_WEBHOOK_URL="${APP_URL}/api/v1/payments/piprapay/webhook"
PIPRAPAY_RETURN_URL="${FRONTEND_URL}/checkout/success"
PIPRAPAY_CANCEL_URL="${FRONTEND_URL}/checkout"

PLATFORM_CURRENCY=BDT
PLATFORM_TIMEZONE=Asia/Dhaka
LANDING_PACKAGE_MAX_COMPRESSION_RATIO=25

VITE_APP_NAME="${APP_NAME}"
